<?xml version="1.0" encoding="utf-8"?>
<!-- Student and guardian details stay on this phone: nothing is copied to
     Google's cloud backup or to a new phone by the system. The app has its own
     backup and restore, which the tutor controls (and can password-protect). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
