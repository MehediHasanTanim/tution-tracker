-- Schema v1. Mirrors docs/design/tuition-tracker-technical-design.md section 6.2.
-- Money is whole taka (INTEGER). Dates are TEXT 'YYYY-MM-DD'. Timestamps are
-- UTC epoch milliseconds. Ids are UUID v4 strings.
-- The fee_balances view is added with the fee data layer (S2-01).

CREATE TABLE students (
  id             TEXT NOT NULL PRIMARY KEY,
  name           TEXT NOT NULL,
  class_level    TEXT,
  school         TEXT,
  guardian_name  TEXT,
  guardian_phone TEXT,
  student_phone  TEXT,
  address        TEXT,
  photo_path     TEXT,
  subjects       TEXT,                                   -- JSON array
  class_days     TEXT,                                   -- JSON [1,3,5] ISO weekdays (one-to-one classes)
  class_time     TEXT,                                   -- HH:mm
  joined_on      TEXT NOT NULL,
  status         TEXT NOT NULL DEFAULT 'active'
                 CHECK (status IN ('active', 'paused', 'left')),
  monthly_fee    INTEGER NOT NULL CHECK (monthly_fee >= 0),
  fee_due_day    INTEGER NOT NULL DEFAULT 10
                 CHECK (fee_due_day BETWEEN 1 AND 31),
  notes          TEXT,
  created_at     INTEGER NOT NULL,
  updated_at     INTEGER NOT NULL
) AS Student;
CREATE INDEX idx_students_status ON students (status);
CREATE INDEX idx_students_name   ON students (name COLLATE NOCASE);

CREATE TABLE batches (
  id            TEXT NOT NULL PRIMARY KEY,
  name          TEXT NOT NULL,
  subject       TEXT,
  class_level   TEXT,
  schedule_days TEXT NOT NULL,                           -- JSON [1,3,5] ISO weekdays
  start_time    TEXT,                                    -- HH:mm
  duration_min  INTEGER,
  default_fee   INTEGER NOT NULL DEFAULT 0 CHECK (default_fee >= 0),
  status        TEXT NOT NULL DEFAULT 'active'
                CHECK (status IN ('active', 'archived')),
  created_at    INTEGER NOT NULL,
  updated_at    INTEGER NOT NULL
) AS Batch;

CREATE TABLE batch_members (
  id           TEXT NOT NULL PRIMARY KEY,
  batch_id     TEXT NOT NULL REFERENCES batches (id),
  student_id   TEXT NOT NULL REFERENCES students (id),
  fee_override INTEGER CHECK (fee_override IS NULL OR fee_override >= 0),
  joined_on    TEXT NOT NULL,
  left_on      TEXT,
  UNIQUE (batch_id, student_id)
) AS BatchMember;
CREATE INDEX idx_members_student ON batch_members (student_id);

CREATE TABLE class_sessions (
  id         TEXT NOT NULL PRIMARY KEY,
  batch_id   TEXT REFERENCES batches (id),
  student_id TEXT REFERENCES students (id),              -- one-to-one classes
  date       TEXT NOT NULL,
  start_time TEXT,
  status     TEXT NOT NULL DEFAULT 'held'
             CHECK (status IN ('held', 'cancelled', 'holiday')),
  topic      TEXT,
  note       TEXT,
  CHECK (batch_id IS NOT NULL OR student_id IS NOT NULL)
) AS ClassSession;
CREATE INDEX idx_sessions_date ON class_sessions (date);
-- COALESCE: SQLite treats NULLs as distinct, so a plain index would let two
-- sessions without a start time on the same day through.
CREATE UNIQUE INDEX uq_session_batch_day
  ON class_sessions (batch_id, date, COALESCE(start_time, ''))
  WHERE batch_id IS NOT NULL;
CREATE UNIQUE INDEX uq_session_student_day
  ON class_sessions (student_id, date, COALESCE(start_time, ''))
  WHERE student_id IS NOT NULL;

CREATE TABLE attendance (
  id         TEXT NOT NULL PRIMARY KEY,
  session_id TEXT NOT NULL REFERENCES class_sessions (id) ON DELETE CASCADE,
  student_id TEXT NOT NULL REFERENCES students (id),
  status     TEXT NOT NULL
             CHECK (status IN ('present', 'absent', 'late', 'excused')),
  UNIQUE (session_id, student_id)
) AS AttendanceRecord;
CREATE INDEX idx_att_student ON attendance (student_id);

CREATE TABLE fee_records (
  id         TEXT NOT NULL PRIMARY KEY,
  student_id TEXT NOT NULL REFERENCES students (id),
  month      TEXT NOT NULL,                              -- YYYY-MM
  kind       TEXT NOT NULL DEFAULT 'monthly'
             CHECK (kind IN ('monthly', 'one_time')),
  label      TEXT,                                       -- for one_time fees
  amount_due INTEGER NOT NULL CHECK (amount_due >= 0),
  discount   INTEGER NOT NULL DEFAULT 0 CHECK (discount >= 0),
  waived     INTEGER NOT NULL DEFAULT 0 CHECK (waived IN (0, 1)),
  due_date   TEXT NOT NULL,
  created_at INTEGER NOT NULL
) AS FeeRecord;
CREATE UNIQUE INDEX uq_fee_monthly
  ON fee_records (student_id, month) WHERE kind = 'monthly';
CREATE INDEX idx_fee_month   ON fee_records (month);
CREATE INDEX idx_fee_student ON fee_records (student_id);

CREATE TABLE payments (
  id          TEXT NOT NULL PRIMARY KEY,
  student_id  TEXT NOT NULL REFERENCES students (id),
  amount      INTEGER NOT NULL CHECK (amount > 0),
  received_on TEXT NOT NULL,
  method      TEXT NOT NULL DEFAULT 'cash'
              CHECK (method IN ('cash', 'bkash', 'nagad', 'rocket', 'bank', 'other')),
  reference   TEXT,
  receipt_no  INTEGER NOT NULL UNIQUE,
  note        TEXT,
  created_at  INTEGER NOT NULL,
  deleted_at  INTEGER
) AS Payment;
CREATE INDEX idx_pay_student ON payments (student_id);
CREATE INDEX idx_pay_date    ON payments (received_on);

CREATE TABLE payment_allocations (
  id            TEXT NOT NULL PRIMARY KEY,
  payment_id    TEXT NOT NULL REFERENCES payments (id) ON DELETE CASCADE,
  fee_record_id TEXT REFERENCES fee_records (id),        -- NULL = unapplied advance credit
  student_id    TEXT NOT NULL REFERENCES students (id),
  amount        INTEGER NOT NULL CHECK (amount > 0)
) AS PaymentAllocation;
CREATE INDEX idx_alloc_fee     ON payment_allocations (fee_record_id);
CREATE INDEX idx_alloc_payment ON payment_allocations (payment_id);
CREATE INDEX idx_alloc_student ON payment_allocations (student_id);

CREATE TABLE fee_changes (
  id              TEXT NOT NULL PRIMARY KEY,
  student_id      TEXT NOT NULL REFERENCES students (id),
  effective_month TEXT NOT NULL,
  new_amount      INTEGER NOT NULL CHECK (new_amount >= 0),
  UNIQUE (student_id, effective_month)
) AS FeeChange;

CREATE TABLE pauses (
  id         TEXT NOT NULL PRIMARY KEY,
  student_id TEXT NOT NULL REFERENCES students (id),
  from_month TEXT NOT NULL,
  to_month   TEXT                                        -- NULL = open-ended
) AS Pause;
CREATE INDEX idx_pauses_student ON pauses (student_id);

CREATE TABLE settings (
  "key" TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
) AS Setting;

CREATE TABLE message_templates (
  id       TEXT NOT NULL PRIMARY KEY,
  kind     TEXT NOT NULL,
  language TEXT NOT NULL,
  body     TEXT NOT NULL
) AS MessageTemplate;

CREATE TABLE audit_log (
  id        TEXT NOT NULL PRIMARY KEY,
  entity    TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  "action"  TEXT NOT NULL,
  details   TEXT,
  at        INTEGER NOT NULL
) AS AuditLogEntry;
CREATE INDEX idx_audit_entity ON audit_log (entity, entity_id);
